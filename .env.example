# Copy to .env (chmod 600) and fill in. All passwords are required;
# generate them e.g. with `openssl rand -hex 32`.

# MariaDB
MYSQL_ROOT_PASSWORD=
ICINGADB_MYSQL_PASSWORD=
ICINGAWEB_MYSQL_PASSWORD=

# Icinga 2 API user `icingaweb` (used by Icinga Web 2)
ICINGAWEB_ICINGA2_API_USER_PASSWORD=

# Icinga Web 2 login `icingaadmin`
ICINGAWEB_ADMIN_PASSWORD=

# Owner of the UNIX sockets web.sock and api.sock: the directory
# SOCKET_DIR must be writable by SOCKET_UID; SOCKET_GID is the reverse
# proxy group (e.g. `getent group caddy`).
SOCKET_UID=1000
SOCKET_GID=
SOCKET_DIR=/run/icinga

# Network prefixes (defaults 172.29.0 and fd00:d0c:29)
#V4_PREFIX=172.29.0
#V6_PREFIX=fd00:d0c:29
