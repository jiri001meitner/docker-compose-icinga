# Values for CI only (GitHub Actions smoke tests). NOT secrets and never
# used in production: the workflows copy this file to .env on a throwaway
# runner. For a real deployment copy .env.example instead.
MYSQL_ROOT_PASSWORD=ci-only-root
ICINGADB_MYSQL_PASSWORD=ci-only-icingadb
ICINGAWEB_MYSQL_PASSWORD=ci-only-icingaweb
ICINGAWEB_ICINGA2_API_USER_PASSWORD=ci-only-api
ICINGAWEB_ADMIN_PASSWORD=ci-only-admin
# root inside the socat sidecars, so the bind-mounted directory that Docker
# creates as root is writable without preparing it on the runner.
SOCKET_UID=0
SOCKET_GID=0
SOCKET_DIR=/tmp/icinga-ci-sockets
